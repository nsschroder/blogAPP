<div class="mb-4">
    <a href="/categoria" class="btn btn-outline-secondary">
        ← Voltar para categorias
    </a>
</div>

<h1>{{categoria.name}}</h1>

<p class="text-muted">
    Postagens da categoria "{{categoria.name}}"
</p>

<hr>

{{#each postagem}}

<div class="card mb-3">

    <div class="card-body">

        <h4>{{title}}</h4>

        <p>{{desc}}</p>

        <small class="text-muted">
            Publicado em {{formatDate date}}
        </small>

        <div class="mt-3">

            <a href="/postagem/{{slug}}" class="btn btn-primary btn-sm">
                Ler mais
            </a>

        </div>

    </div>

</div>

{{else}}

<div class="alert alert-info">
    Nenhuma postagem encontrada nesta categoria.
</div>

{{/each}}