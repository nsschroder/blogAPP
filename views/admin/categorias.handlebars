<h2>Lista de categorias:</h2>
<hr>
<a href="/admin/categoria/add"><button class="btn btn-success">Adicionar</button></a>

{{#each categoria}}
<div class="card mt-4">
    <div class="card-body">
        <h4>{{name}}</h4>
        <small>Slug: {{slug}}</small><br>
        <small>Data de ciração: {{formatDate date}}</small><br>
        <a href="/admin/categoria/edit/{{_id}}"><button class="btn btn-success mt-2">Editar</button></a>
    </div>
</div>

{{else}}

{{/each}}