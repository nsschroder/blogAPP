<h2>Lista de categorias:</h2>
<hr>
<a href="/admin/categoria/add"><button class="btn btn-success">Adicionar</button></a>

{{#each categoria}}

<div class="card mt-4">
    <div class="card-body">

        <h4>{{name}}</h4>

        <small>Slug: {{slug}}</small><br>
        <small>Data de criação: {{formatDate date}}</small>

        <div class="d-flex gap-2 mt-3">

            <a href="/admin/categoria/edit/{{_id}}" class="btn btn-success">
                Editar
            </a>

            <form action="/admin/categoria/del" method="post" class="m-0">
                <input type="hidden" name="id" value="{{_id}}">

                <button type="submit" class="btn btn-danger">
                    Excluir
                </button>
            </form>

        </div>

    </div>
</div>

{{else}}

<h4 class="mt-3">Nenhuma categoria registrada.</h4>

{{/each}}