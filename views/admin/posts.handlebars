<h2>Lista de postagens</h2>
<hr>

<div class="mb-4">
    <a href="/admin/postagem/add" class="btn btn-success">
        Nova postagem
    </a>
</div>

{{#each postagem}}

<div class="card mb-3">
    <div class="card-body">

        <h4 class="mb-2">{{title}}</h4>

        <p class="mb-3">{{desc}}</p>

        <div class="mb-2">
            <small class="text-muted">
                Categoria: {{cat.name}}
            </small>
            <br>
            <small class="text-muted">
                Data de postagem: {{formatDate date}}
            </small>
        </div>
        <div class="d-flex gap-2 mt-3">

            <a href="/admin/postagem/edit/{{_id}}" class="btn btn-success">
                Editar
            </a>

            <form action="/admin/postagem/del" method="post" class="m-0">
                <input type="hidden" name="id" value="{{_id}}">

                <button type="submit" class="btn btn-danger"
                    onclick="return confirm('Deseja realmente excluir esta postagem?')">
                    Excluir
                </button>
            </form>

        </div>
    </div>
</div>

{{else}}

<h4>Nenhuma postagem registrada!</h4>

{{/each}}