<h2>Usuários</h2>

<table class="table">

    <tr>
        <th>Nome</th>
        <th>Email</th>
        <th>Admin</th>
        <th>Ações</th>
    </tr>

    {{#each users}}

    <tr>

        <td>{{name}}</td>
        <td>{{email}}</td>

        <td>
            {{#if eAdmin}}
            Admin
            {{else}}
            Usuário
            {{/if}}
        </td>

        <td>

            {{#if eAdmin}}

            <form action="/admin/users/removeadmin" method="post">
                <input type="hidden" name="id" value="{{_id}}">
                <button class="btn btn-danger btn-sm">
                    Remover Admin
                </button>
            </form>

            {{else}}

            <form action="/admin/users/admin" method="post">
                <input type="hidden" name="id" value="{{_id}}">
                <button class="btn btn-success btn-sm">
                    Tornar Admin
                </button>
            </form>

            {{/if}}

        </td>

    </tr>

    {{/each}}

</table>